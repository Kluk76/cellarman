### warn:R1c — R1c fire: config set to .githooks
git config core.hooksPath .githooks
### warn:R1c — R1c fire: config set to ./.githooks
git config core.hooksPath ./.githooks
### warn:R1c — R1c fire: --local scope
git config --local core.hooksPath .githooks
### warn:R1c — R1c fire: --worktree scope in a worktree
git -C "$WT" config --worktree core.hooksPath .githooks
### warn:R1c — R1c fire: --global scope
git config --global core.hooksPath .githooks
### warn:R1c — R1c fire: chained after cd
cd "$WT" && git config core.hooksPath .githooks
### allow — R1c near: read with --get
git config --get core.hooksPath
### allow — R1c near: read with no value
git config core.hooksPath
### allow — R1c near: other key set to .githooks
git config core.something .githooks
