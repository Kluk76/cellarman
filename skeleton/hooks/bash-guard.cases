git add f.txt && git add -A
### block:R2 — R2 fire: inside bash -c
bash -c "git add ."
### block:R2 — R2 fire: quoted dot
git add "."
### block:R2 — R2 fire: in a brace group
{ git add -A; }
### block:R2 — R2 fire: with -C global option
git -C /repo add --all
### allow — R2 near: ./path
git add ./path
### allow — R2 near: .claude/x
git add .claude/x
### allow — R2 near: .gitignore
git add .gitignore
### allow — R2 near: -u alone
git add -u
### allow — R2 near: --update alone
git add --update
### allow — R2 near: -u with a pathspec
git add -u src
### allow — R2 near: explicit files
git add src/a.php app/b.php
### allow — R2 near: -n dry run of one file
git add -n file
### allow — R2 near: parent directory token
git add ..
### allow — R2 near: -p patch mode on a file
git add -p file.php
### allow — R2 near: -u with dot is tracked-only
git add -u .
### allow — R2 near: echoed text
echo git add -A
### allow — R2 near: commit message text
git commit -m "never git add -A here"
### allow — R2 near: git status with a dot
git status .
### allow — R2 near: another subcommand with -A
git stash -A
### warn:R4 — R4 fire: git push piped to tail
git push origin main 2>&1 | tail -5
### warn:R4 — R4 fire: git pull piped
git pull | cat
### warn:R4 — R4 fire: git rebase with |&
git rebase origin/main |& tee /dev/null
### warn:R4 — R4 fire: git merge piped
git merge topic | head
### warn:R4 — R4 fire: pm-preflight.sh piped to tee
bin/pm-preflight.sh --apply | tee log
### warn:R4 — R4 fire: pm-preflight via bash
bash scripts/pm-preflight.sh | head
### warn:R4 — R4 fire: pm-preflight.sh piped
claude-brain/pm-preflight.sh --strict | tail -3
### warn:R4 — R4 fire: group stage carrying a push
(git push origin main) | tail
### warn:R4 — R4 fire: ssh remote deploy piped
ssh myhost 'cd /srv && bin/pm-preflight.sh --verify' | tail
### warn:R4 — R4 fire: trigger in the middle stage
git push 2>&1 | tee x | tail
### warn:R4 — R4 fire: brace group with a rebase piped
{ git rebase main; } | cat
### allow — R4 near: || is not a pipe
git push || echo failed
### allow — R4 near: redirect then read rc
git push > /dev/null 2>&1; rc=$?
### allow — R4 near: pipe from a non-trigger
git status | head
### allow — R4 near: git log piped
git log | head
### allow — R4 near: merge-base is not merge
git merge-base a b | head
### allow — R4 near: trigger is the LAST stage
echo x | git push
### allow — R4 near: apply patch from diff
git diff | git apply
### allow — R4 near: grep for the script name
grep pm-preflight.sh notes.txt | head
### allow — R4 near: push alone
git push origin main
### allow — R4 near: push in a message
git commit -m "git push | tail"
### allow — R4 near: echoed text
echo "git pull | cat"
### allow — R4 near: &> redirect is not a pipe
git push &> /dev/null
### allow — R4 near: push then a separate piped log
git push origin main && git log | head
### allow — R4 near: 2>&1 alone
git push 2>&1
### allow — R4 near: command -v is a lookup
command -v git push | head
### block:R5 — R5 fire: push piped then echo pushed
git push origin main 2>&1 | tail -3 && echo pushed
### block:R5 — R5 fire: deploy piped then echo
bin/pm-preflight.sh --apply --yes | tail -3 && echo "deployed"
### block:R5 — R5 fire: pull piped, echo on the next line after &&
git pull --ff-only 2>&1 | tail -2 &&
echo "pulled"
### block:R5 — R5 fire: ssh deploy piped then echo
ssh myhost 'cd /srv && bin/pm-preflight.sh --verify' | tail -2 && echo clean
### block:R5 — R5 fire: trigger in the middle stage
git rebase main 2>&1 | tee x | tail -1 && echo rebased
### block:R5 — R5 fire: echo preceded by an unrelated clean command
ls && git merge topic | cat && echo merged
### allow — R5 near: plain pipeline then divider echo
git log | head && echo "=== done ==="
### allow — R5 near: grep pipeline then echo
cat f | grep x && echo found
### allow — R5 near: three non-trigger stages
a | b | c && echo ok
### allow — R5 near: heredoc feeding a non-trigger pipeline
cat <<EOF | grep x && echo y
x
EOF
### allow — R5 near: trigger LAST in the pipeline
echo x | git push && echo pushed
### warn:R4 — R5 near: trigger pipeline then another command before echo (R4 only)
git push 2>&1 | tail -1 && ls && echo ok
### warn:R4 — R5 near: trigger pipeline with || echo (R4 only)
git push 2>&1 | tail -1 || echo failed
### allow — R5 near: single command then echo
ls && echo ok
### allow — R5 near: semicolon
ls | wc -l; echo ok
### allow — R5 near: || echo
ls | wc -l || echo fail
### allow — R5 near: pipeline then another command before echo
ls | wc -l && ls && echo ok
### allow — R5 near: newline separator
ls | wc -l
echo ok
### allow — R5 near: echo inside quotes
echo "a | b && echo ok"
### allow — R5 near: no pipe
grep x f && echo found
### allow — R5 near: pipeline then non-echo command
cat f | wc && ls
### allow — R5 near: comment text
ls # a | b && echo ok
### allow — R5 near: background & is not &&
ls | wc -l & echo ok
### allow — R5 near: && echo whose pipeline is only on the echo side
ls && echo ok | cat
