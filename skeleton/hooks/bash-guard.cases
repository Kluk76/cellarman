### block:R1 — M background ampersand separates commands
sleep 1 & git commit -n -m x
### block:R2 — M for loop body
for f in a b; do git add -A; done
### block:R1 — M nohup wrapper
nohup git commit -n -m x
### block:R1 — M command wrapper (not -v)
command git commit -n -m x
### allow — M command -v is a lookup
command -v git commit -n
### block:R1 — M empty fd redirect before the command
2>/dev/null git commit -n -m x
### allow — M empty command
### allow — M plain harmless commands
ls -la && git status && git diff --stat
### allow — M arithmetic expansion is not a group of commands
echo $((1+2)) && git commit -m x
### allow — M parameter expansion with braces
echo ${HOME:-x} ${#HOME}
### block:R1 — M parameter expansion then bypass
echo ${HOME} && git commit -n -m x
### allow — M case statement text
case x in a) echo hi;; esac
### allow — M test expression with parentheses and pipes
[[ $x =~ (a|b) ]] && echo ok
### allow — M ssh payload that needs run-time variables to tokenise is not warned about
R="sudo bash -c 'cd /srv && ls"
ssh myhost "$R --x'" > /dev/null 2>&1
### warn:PARSE — M bash -c payload that does not tokenise is reported
bash -c 'git commit -n -m "x'
### allow — R1b near: arming value .githooks via -c is allowed per command
git -c core.hooksPath=.githooks commit -F - > /dev/null 2>&1 <<'MSG'
msg
MSG
### warn:R1c — R1c fire: persistent arming via config is announced
cd "$WT" && git config core.hooksPath .githooks && echo "hooksPath=$(git config --get core.hooksPath)"
### allow — R4 near: ssh payload pipes something that is not a trigger
ssh myhost 'cd /var/www/myhost && ls | tail -3'
### allow — R5 near: divider echo after a plain pipeline
grep -n foo f.txt | head -3 && echo "=== next ==="
### allow — R1b near: -c arming with ./.githooks
git -c core.hooksPath=./.githooks commit -m x
### allow — R1b near: -c arming with quotes around the value
git -c "core.hooksPath=.githooks" merge --no-edit origin/main
### allow — R1b near: -c arming, other -c keys alongside
git -c user.name=x -c core.hooksPath=.githooks status
### block:R1b — R1b fire: -c with an empty value
git -c core.hooksPath= commit -m x
### block:R1b — R1b fire: -c with /dev/null
git -c core.hooksPath=/dev/null commit -m x
### block:R1b — R1b fire: -c with another directory
git -c core.hooksPath=.git/hooks commit -m x
### block:R1b — R1b fire: -c with a near-miss of the arming value
git -c core.hooksPath=.githooks2 commit -m x
### block:R1b — R1b fire: -c with a bare key
git -c core.hooksPath commit -m x
### block:R1b — R1b fire: config set to another value
git config core.hooksPath /dev/null
### block:R1b — R1b fire: config --replace-all with another value
git config --replace-all core.hooksPath .git/hooks
### allow — R1b near: arming commit with a heredoc message full of dangerous words
git -c core.hooksPath=.githooks commit -F - <<'MSG'
fix: never use --no-verify | tail && echo ok; git add -A
