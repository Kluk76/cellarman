bash-guard test cases -- run with:  bash .claude/hooks/bash-guard.sh --self-test   (or skeleton/hooks/bash-guard.sh in the kit)

Some R1/R1b cases are adapted from affaan-m/ecc (tests/hooks/block-no-verify.test.js), MIT License, Copyright (c) 2026 Affaan Mustafa.

FORMAT
  Everything before the first "### " header line is documentation (this text).
  A case is a header line
        ### <expect> — <label>
  followed by the RAW command, byte for byte (it may span several lines, e.g. a
  heredoc), up to the next "### " line or the end of the file. The command is
  never executed: the self-test only feeds it, wrapped in hook JSON, to the guard.
  <expect> is exactly one of
        allow                 no output, exit 0
        warn:<ids>            a WARN context naming the rules (ids joined by +)
        block:<ids>           exit 2 naming the rules (block wins; every matched
                              rule id is listed, warn rules included, e.g. block:R1+R4)
        warn:PARSE            the command could not be analysed
  Labels start with the rule they exercise: "R1 fire" = must trip R1, "R1 near" =
  a near-miss that must NOT trip it. Other prefixes: HD heredoc, Q quoting, M misc.
  Never start a command line with three hashes.

### block:R1 — R1 fire: --no-verify long form
git commit --no-verify -m "msg"
### block:R1 — R1 fire: -n short
git commit -n -m "msg"
### block:R1 — R1 fire: -nm cluster, message separate
git commit -nm "msg"
### block:R1 — R1 fire: -an cluster
git commit -an
### block:R1 — R1 fire: git push --no-verify
git push --no-verify
### block:R1 — R1 fire: git push --no-verify with remote and branch
git push origin main --no-verify
### block:R1 — R1 fire: global option -C between git and subcommand
git -C dir commit -n
### block:R1 — R1 fire: leading env assignment
FOO=bar git commit -n
### block:R1 — R1 fire: quoted flag is still the flag
git commit "--no-verify" -m "msg"
### block:R1 — R1 fire: later command in a chain
git commit -m ok; git commit -am x -n
### block:R1 — R1 fire: after a clean command with &&
git log -n 5 && git commit --no-verify -m "msg"
### block:R1 — R1 fire: push --no-verify after commit
git commit -m "msg" && git push --no-verify
### block:R1 — R1 fire: sudo wrapper with -u
sudo -u deploy git commit -n -m x
### block:R1 — R1 fire: timeout wrapper
timeout 10 git push --no-verify
### block:R1 — R1 fire: -sn cluster
git commit -sn -m "msg"
### block:R1 — R1 fire: n after a no-value letter then value letters
git commit -nu -m "msg"
### block:R1 — R1 fire: abbreviated --no-veri
git commit --no-veri -m "msg"
### block:R1 — R1 fire: abbreviated push --no-verif
git push --no-verif origin main
### block:R1 — R1 fire: backslash-newline continuation joins lines
git commit \
--no-verify -m x
### block:R1 — R1 fire: inside bash -c payload
bash -c 'git commit -n -m x'
### block:R1 — R1 fire: inside sh -c double-quoted payload
sh -c "git commit --no-verify -m x"
### block:R1 — R1 fire: inside command substitution
echo "$(git commit -n -m x)"
### block:R1 — R1 fire: inside backticks
echo `git commit -n -m x`
### block:R1 — R1 fire: inside subshell group
(git commit -m ok; git push --no-verify)
### block:R1 — R1 fire: inside brace group
{ git commit -n -m x; }
### block:R1 — R1 fire: inside if-then
if true; then git commit -n -m x; fi
### block:R1 — R1 fire: single-quoted git word with quote assembly
'git' commit -n -m x
### block:R1 — R1 fire: ssh remote command
ssh myhost 'cd /srv/x && git commit -n -m x'
### block:R1 — R1 fire: eval of a literal
eval "git commit --no-verify -m x"
### block:R1 — R1 fire: time wrapper
time git commit -n -m x
### block:R1 — R1 fire: env wrapper with unset
env -u HOME git push --no-verify
### block:R1 — R1 fire: git global option --no-pager
git --no-pager commit -n -m x
### allow — R1 near: -m value that looks like -n
git commit -m "-n"
### allow — R1 near: -m value mentioning --no-verify
git commit -m "use --no-verify"
### allow — R1 near: -F file
git commit -F file
### allow — R1 near: -mn is the message n
git commit -mn
### allow — R1 near: git push -n is --dry-run
git push -n
### allow — R1 near: git push --dry-run -n origin
git push --dry-run -n origin main
### allow — R1 near: -uno is the untracked mode
git commit -uno -m "msg"
### allow — R1 near: -Sn optional gpg key value
git commit -Sn -m "msg"
### allow — R1 near: -tn template value
git commit -tn -m "msg"
### allow — R1 near: -am with a -n message
git commit -am "-n"
### allow — R1 near: git log -n then a clean commit
git log -n 10 && git commit -m "msg"
### allow — R1 near: echo --no-verify then clean commit
echo --no-verify && git commit -m "msg"
### allow — R1 near: --no-verbose is not --no-verify
git commit --no-verbose -m "msg"
### allow — R1 near: after -- everything is a pathspec
git commit -m x -- --no-verify
### allow — R1 near: redirect target named --no-verify
git commit -m safe > --no-verify
### allow — R1 near: comment mentions --no-verify
git commit -m safe # --no-verify
### allow — R1 near: -n belongs to git log
git -C dir log -n 5
### allow — R1 near: git fetch -n is not commit
git fetch -n origin
### allow — R1 near: -F with a file named -n is the value
git commit -F -n
### allow — R1 near: -C reuse-message value
git commit -C HEAD -m x
### allow — R1 near: bash -c payload is clean
bash -c 'echo --no-verify'
### allow — R1 near: git commit-tree is another subcommand
git commit-tree -n abc
### allow — R1 near: 'commit' as a refspec of push
git push origin commit
### allow — R1 near: -m "--no-verify" with a separated value
git commit -m "--no-verify"
### allow — R1 near: --message= joined value
git commit --message="skip --no-verify"
### block:R1b — R1b fire: -c core.hooksPath
git -c core.hooksPath=/dev/null commit -m "msg"
### block:R1b — R1b fire: quoted -c value
git -c "core.hooksPath=/dev/null" commit -m "msg"
### block:R1b — R1b fire: lowercase key
git -c core.hookspath=/dev/null commit -m "msg"
### block:R1b — R1b fire: upper-case key, any subcommand
git -c core.HOOKSPATH=/dev/null status
### block:R1b — R1b fire: config set
git config core.hooksPath /dev/null
### block:R1b — R1b fire: config --local set to empty string
git config --local core.hooksPath ''
### block:R1b — R1b fire: config --global --unset
git config --global --unset core.hooksPath
### block:R1b — R1b fire: config --worktree set
git config --worktree core.hooksPath /tmp/h
### block:R1b — R1b fire: config --file set
git config --file .git/config core.hooksPath /tmp/h
### block:R1b — R1b fire: --unset-all
git config --unset-all core.hooksPath
### block:R1b — R1b fire: --config-env joined
git --config-env=core.hooksPath=HP commit -m x
### block:R1b — R1b fire: -c after -C
git -C dir -c core.hooksPath=/dev/null push
### block:R1b — R1b fire: config --replace-all
git config --replace-all core.hooksPath /x
### allow — R1b near: reading with --get
git config --get core.hooksPath
### allow — R1b near: reading with no value
git config core.hooksPath
### allow — R1b near: --get-all
git config --get-all core.hooksPath
### allow — R1b near: global --get
git config --global --get core.hooksPath
### allow — R1b near: other -c key
git -c user.name=x commit -m msg
### allow — R1b near: -c core.editor
git -c core.editor=true commit -m msg
### allow — R1b near: key that only starts like hooksPath
git -c core.hooksPathX=1 status
### allow — R1b near: echoed text
echo "git config core.hooksPath /dev/null"
### allow — R1b near: other config key set
git config user.name "Someone"
### allow — R1b near: config --list
git config --list
### allow — R1b near: commit message about hooksPath
git commit -m "doc: explain core.hooksPath= setting"
### allow — R1b near: grep for the key
grep core.hooksPath .git/config
### allow — R1b near: -c value of another key containing the word
git -c alias.x="status core.hooksPath=y" status
### block:R2 — R2 fire: -A
git add -A
### block:R2 — R2 fire: --all
git add --all
### block:R2 — R2 fire: bare dot
git add .
### block:R2 — R2 fire: -A inside a cluster
git add -Av
### block:R2 — R2 fire: dot after --
git add -- .
### block:R2 — R2 fire: force + dot
git add -f .
