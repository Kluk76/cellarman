### allow — Q backslash-escaped space keeps one word
git add path\ with\ space/file.txt
### block:R2 — Q hash inside a word is not a comment
echo foo#bar; git add -A
### block:R2 — Q quoted hash is not a comment
echo "#"; git add -A
### allow — M comment hides everything after it
ls # git add -A && git commit -n
### block:R2 — M comment ends at the newline
ls # git commit -n
git add -A
### allow — M 2>&1 is not a separator
git commit -m x 2>&1
### block:R1 — M 2>&1 does not hide a flag
git commit -n 2>&1
### block:R1 — M &> redirect is not a separator
