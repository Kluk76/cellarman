### block:R1 — HD here-string does not swallow later lines
cat <<< "text"
git commit -n -m x
### allow — HD heredoc with empty body
cat <<EOF
EOF
### allow — HD heredoc never terminated is still data
cat <<EOF
git add -A
git commit -n
### allow — Q double quotes hide separators and flags
git commit -m "never use --no-verify | tail && echo ok"
### allow — Q single quotes hide a blanket add
git commit -m 'git add -A'
### allow — Q ANSI-C quoting is data
echo $'git commit -n; git add -A'
### warn:PARSE — Q unbalanced double quote
echo "abc
### warn:PARSE — Q unbalanced single quote in a commit
git commit -m 'abc
### warn:PARSE — Q unbalanced command substitution
echo $(git status
### allow — Q apostrophe inside double quotes
git commit -m "it's fine --no-verify"
### allow — Q double quotes inside single quotes
git commit -m 'say "hi" -n'
### block:R1 — Q adjacent quoted pieces then a bypass
echo 'a'"b" && git commit -n
### block:R1 — Q substitution inside double quotes is executed
git commit -m "$(echo hi)" -n
### block:R2 — Q quoted dot
git add '.'
### allow — Q printf with a quoted pipeline text
printf '%s' "git push | tail"
### allow — Q escaped quote inside double quotes
