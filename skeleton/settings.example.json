{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pm-consult-nudge.sh",
            "args": ["acme-pm"],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/bash-guard.sh\"; bash -n \"$f\" 2>/dev/null || { echo \"bash-guard INACTIVE: $f is missing or does not parse under this bash\" >&2; exit 1; }; bash \"$f\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/claude-brain/pm-kit/load-telemetry.sh",
            "args": [],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/claude-brain/pm-kit/kernel/session-ledger.sh",
            "args": [],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/claude-brain/pm-sync.sh",
            "args": [],
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "${CLAUDE_PROJECT_DIR}/claude-brain/pm-sync.sh",
            "args": [],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
